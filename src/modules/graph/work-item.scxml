<?xml version="1.0" encoding="UTF-8"?>
<scxml
  xmlns="http://www.w3.org/2005/07/scxml"
  version="1.0"
  datamodel="ecmascript"
  initial="pre_pr">
  <!--
    Canonical work-item lifecycle for Studio's HSM epic.

    Notes for downstream integration phases:
    - `pre_pr` is a composite superstate for all planning/execution work that
      happens before a pull request exists.
    - `pre_pr_history` is a shallow history node used by `deferred` to resume
      the last active pre-PR child state.
    - Runs remain separate entities. Their terminal outcomes are projected into
      this machine through `run.*` events rather than modeled as nested run
      substates here.
  -->

  <!-- Pre-PR lifecycle: planning, approval, execution, and run recovery. -->
  <state id="pre_pr" initial="planned">
    <!--
      Shallow history restores whichever child of `pre_pr` was active when the
      item was deferred. Default is `planned` if no prior child state exists.
    -->
    <history id="pre_pr_history" type="shallow">
      <transition target="planned" />
    </history>

    <!-- Human defer/cancel apply uniformly to all pre-PR child states. -->
    <transition event="user.defer" target="deferred" />
    <transition event="user.cancel" target="cancelled" />

    <!-- `planned`: issue exists, but no draft plan has started yet. -->
    <state id="planned">
      <transition event="draft.start" target="drafting" />
    </state>

    <!-- `drafting`: the canonical scratchpad is being authored or revised. -->
    <state id="drafting">
      <transition event="draft.approve" target="ready" />
      <transition event="draft.discard" target="planned" />
    </state>

    <!-- `ready`: the plan is approved and an execution run may be launched. -->
    <state id="ready">
      <transition event="draft.reopen" target="drafting" />
      <transition event="run.launch" target="in_progress" />
    </state>

    <!-- `in_progress`: a run is actively executing against the approved plan. -->
    <state id="in_progress">
      <transition event="run.pr_opened" target="../open_pr" />
      <transition event="run.retry_ready" target="ready" />
      <transition event="run.retry_drafting" target="drafting" />
      <transition event="run.errored" target="run_errored" />
    </state>

    <!--
      `run_errored`: the latest run ended in an error state that needs triage
      before the work item can continue.
    -->
    <state id="run_errored">
      <transition event="user.retry" target="ready" />
      <transition event="draft.revise_after_error" target="drafting" />
    </state>
  </state>

  <!-- `open_pr`: a pull request exists and is awaiting an external outcome. -->
  <state id="open_pr">
    <transition event="gh.pr_merged" target="merged_pr" />
    <transition event="gh.pr_closed" target="closed" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <!--
    `merged_pr`: the PR merged successfully; a human must now decide whether to
    close normally or archive-and-close.
  -->
  <state id="merged_pr">
    <transition event="user.close" target="done" />
    <transition event="user.archive" target="archived" />
  </state>

  <!--
    `closed`: the PR was closed without merge. The item may be reopened to a
    PR flow, sent back to planning, or cancelled outright.
  -->
  <state id="closed">
    <transition event="gh.pr_reopened" target="open_pr" />
    <transition event="draft.reopen" target="drafting" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <!--
    `deferred`: paused outside the active queue. `user.undefer` resumes the
    prior pre-PR child state through shallow history.
  -->
  <state id="deferred">
    <transition event="user.undefer" target="pre_pr_history" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <!-- `done`: closed out without archiving the plan directory. -->
  <final id="done" />

  <!-- `archived`: closed out and archived as part of disposition. -->
  <final id="archived" />

  <!-- `cancelled`: terminal abandonment of the work item. -->
  <final id="cancelled" />
</scxml>
