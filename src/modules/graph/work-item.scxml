<?xml version="1.0" encoding="UTF-8"?>
<scxml
  xmlns="http://www.w3.org/2005/07/scxml"
  version="1.0"
  datamodel="ecmascript"
  initial="pre_pr">
  <state id="pre_pr" initial="planned">
    <history id="pre_pr_history" type="shallow">
      <transition target="planned" />
    </history>

    <transition event="user.defer" target="deferred" />
    <transition event="user.cancel" target="cancelled" />

    <state id="planned">
      <transition event="user.start_draft" target="drafting" />
    </state>

    <state id="drafting">
      <invoke id="plan-drafter" />
      <onentry>
        <script>kickOffPlanDrafter()</script>
      </onentry>
      <transition event="draft.completed" target="ready" />
      <transition event="draft.failed" target="planned" />
    </state>

    <state id="ready">
      <transition event="user.start_draft" target="drafting" />
      <transition event="user.dispatch" target="in_progress" />
    </state>

    <state id="in_progress">
      <onentry>
        <script>createRunRecord()</script>
      </onentry>
      <transition event="run.completed" cond="prExistsForBranch" target="../open_pr" />
      <transition event="run.completed" target="ready" />
      <transition event="run.failed" target="run_errored" />
    </state>

    <state id="run_errored">
      <transition event="user.retry" target="ready" />
      <transition event="user.start_draft" target="drafting" />
    </state>
  </state>

  <state id="open_pr">
    <transition event="gh.pr_merged" target="merged_pr" />
    <transition event="gh.pr_closed" target="closed" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <state id="merged_pr">
    <onentry>
      <script>stampMeta('studio_post_merge_sync')</script>
    </onentry>
    <onexit>
      <script>closeGhIssue()</script>
    </onexit>
    <transition event="user.finalize" target="done" />
    <transition event="user.archive_and_finalize" target="archived" />
  </state>

  <state id="closed">
    <transition event="gh.pr_reopened" target="open_pr" />
    <transition event="user.start_draft" target="drafting" />
    <transition event="user.finalize" target="done" />
    <transition event="user.archive_and_finalize" target="archived" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <state id="deferred">
    <transition event="user.undefer" target="pre_pr_history" />
    <transition event="user.cancel" target="cancelled" />
  </state>

  <final id="done" />

  <final id="archived">
    <onentry>
      <script>runArchiver()</script>
    </onentry>
  </final>

  <final id="cancelled" />
</scxml>
