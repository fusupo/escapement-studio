@startuml system-overview
title Escapement Studio — System Overview

skinparam componentStyle rectangle
skinparam defaultFontName "Fira Sans"
skinparam shadowing false

actor "Human\nplanner" as User

package "Browser (Svelte 5 + Vite)" as Browser {
  [App.svelte\n(Planning / Execute /\nReconcile / Settings tabs)] as App
  [PlannerChatAdapter] as Chat
  [GraphView\n(d3 + dagre-d3)] as Graph
  [ExecutionDispatchPanel] as Exec
  [ReconciliationPanel] as Recon
  [SettingsPanel] as Sett
  [lib/api.js\nREST client] as ApiLib
  [lib/planner-chat.js\nSSE subscriber] as SseLib
}

package "Escapement Studio API\n(NestJS + @nestjs/cqrs)" as Api {
  [GraphController\n/api/graph, /api/work-items,\n/api/edges, /api/frontier, /api/plan] as GraphCtrl
  [PlanningController\n/api/agent/*] as PlanCtrl
  [PlansController\n/api/plans/*] as PlansCtrl
  [ExecutionController\n/api/execution/*] as ExecCtrl
  [GitHubController\n/api/github/*] as GhCtrl
  [GitHubCacheController\n/api/github-cache/refresh] as GhCacheCtrl
  [WorkItemReconcilerController\n/api/work-items/reconciled] as ReconCtrl
  [DriftReportController\n/api/reconciliation/reports] as DriftCtrl
  [SettingsController\n/api/settings/*] as SettCtrl
  [HealthController\n/health] as HealthCtrl
}

database "SQLite\n.manifest/manifest.db\nwork_items + edges\n+ studio_metadata" as DB

folder "Context root\n(default: /home/marc/escapement-studio-ctx)" as Ctx {
  [plans/<slug>/] as Plans
  [runs/<id>/] as Runs
  [worktrees/<branch>/] as Worktrees
  [archives/<slug>/] as Archives
}

folder "Repo files" {
  [PLANNING_MEMORY.md] as Memory
  [STUDIO_OVERVIEW.md\nSTUDIO_ARCHITECTURE.md] as Docs
  [.studio/planning/sessions/\npi session JSONL] as PiSession
  [.github/ISSUE_TEMPLATE/] as IssueTemplates
}

cloud "External" {
  [GitHub via gh CLI] as GH
  [git worktree] as Git
  [pi-coding-agent\n(Anthropic / OpenAI / ...)] as Pi
  [SCION-CORE\n(SCXML interpreter)] as Scion
}

User --> App
App --> ApiLib
App --> SseLib
ApiLib --> Api : REST
SseLib --> Api : SSE\n/api/agent/stream\n/api/execution/stream\n/api/graph/stream

Api --> DB
Api --> Ctx
Api --> Memory
Api --> Docs
Api --> PiSession
Api --> IssueTemplates

Api --> GH : execFileSync("gh", ...)
Api --> Git : execFileSync("git", ...)
Api ..> Pi : createAgentSession
Api ..> Scion : work-item.scxml

@enduml
