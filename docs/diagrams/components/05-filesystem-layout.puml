@startuml filesystem-layout
title Context root — filesystem layout (ADR 014)

skinparam shadowing false

folder "<artifact-root>\n(default: /home/marc/escapement-studio-ctx)" as Root {
  folder "plans/" as PlansDir {
    folder "studio_123/" {
      file "SCRATCHPAD_studio_123.md" as plan_sp
      file "metadata.json\n- plan_id\n- state (drafting|ready|null)\n- approved_at / approved_by\n- run_ids[]\n- scratchpad_path" as plan_md
    }
  }

  folder "runs/" as RunsDir {
    folder "exec_1713000000/\n(execution run)" {
      file "metadata.json\n(stable provenance)" as er_md
      file "status.json\n(ExecutionRunRecord snapshot —\nrestart-recovery source of truth)" as er_status
      file "events.jsonl\n(append-only event log)" as er_events
      file "summary.md" as er_sum
      folder "outputs/" {
        file "response.json" as er_resp
        file "pull-request.json" as er_pr
      }
    }
    folder "sub_1713000000/\n(sub-agent run)" {
      file "metadata.json" as sr_md
      file "status.json" as sr_status
      file "events.jsonl" as sr_events
      file "summary.md" as sr_sum
      folder "outputs/" as sr_out
    }
  }

  folder "worktrees/" as WtDir {
    folder "studio-123-branch/\n(isolated git worktree —\nbranch checked out from base_ref)"
  }

  folder "archives/" as ArchDir {
    folder "studio_123/" {
      file "README.md\n(generated by run-archiver)" as ar_readme
      file "SCRATCHPAD_studio_123.md\n(moved from plans/)" as ar_sp
      file "metadata.json\n(moved from plans/)" as ar_md
      folder "runs/" {
        folder "exec_.../\n(moved from runs/)" as ar_run
      }
    }
  }
}

note right of plan_sp
  canonical source of truth
  across multiple runs;
  copied into worktree at
  launch and synced back at
  each phase boundary
end note

note right of er_status
  orphan detection on startup
  rewrites non-terminal runs
  to "error" in place; close/
  archive flows stamp
  disposed_at but preserve dir
end note

note bottom of ArchDir
  Archive flow (user.archive_and_finalize)
  moves plans/<slug>/ → archives/<slug>/
  and terminal runs/<id>/ → archives/<slug>/runs/<id>/.
  archive-reader.ts surfaces these bundles
  via GET /api/execution/archived-runs.
end note

@enduml
