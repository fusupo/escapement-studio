@startuml backend-modules
title Escapement Studio — Backend modules (NestJS)

skinparam packageStyle rectangle
skinparam shadowing false

package "@Global PlatformModule" as Platform {
  [SQLiteService]
  [CqrsModule\nCommandBus / EventBus / QueryBus]
}

package GraphModule {
  [WorkItemsService]
  [EdgesService]
  [GraphService]
  [GraphWriterService]
  [WorkItemHsmService\n(SCION)]
  [GraphEventsService]
}

package GitHubModule {
  [GitHubService]
  [GitHubBatchCache\n(60s TTL)]
  [GitHubCacheScheduler\n@Cron EVERY_MINUTE]
  [StudioIssueTemplateService]
}

package SettingsModule {
  [SettingsService]
  [ModelRegistryService]
}

package PlansModule {
  [PlansService]
  [PlanDrafterService]
  [WorkItemDeletedHandler]
}

package PlanningModule {
  [PlanningService]
  [ContextService]
  [MemoryService]
  [ProposalStateService]
  [SubAgentService]
  [tool-registry\n(10 custom tools)]
}

package ExecutionModule {
  [ExecutionService]
  [RunStore]
  [WorktreeService]
  [ScratchpadService]
  [RunInteractionService]
  [PullRequestService]
  [RunDispositionService]
  [HsmActionHandlers]
  [WorkItemReconcilerService]
  [CQRS command handlers]
  [PullRequestTruthRefreshedHandler]
}

package DriftReportModule {
  [DriftReportService]
}

package HealthModule {
  [HealthService]
}

' Global platform is implicitly available everywhere
Platform <.. GraphModule : global
Platform <.. GitHubModule : global
Platform <.. SettingsModule : global
Platform <.. PlansModule : global
Platform <.. PlanningModule : global
Platform <.. ExecutionModule : global
Platform <.. DriftReportModule : global
Platform <.. HealthModule : global

' Direct @Module imports
GitHubModule --> GraphModule
PlansModule --> GraphModule
PlansModule --> GitHubModule
PlansModule --> SettingsModule
PlanningModule --> GraphModule
PlanningModule --> GitHubModule
PlanningModule --> SettingsModule
PlanningModule --> DriftReportModule
ExecutionModule --> GraphModule
ExecutionModule --> GitHubModule
ExecutionModule --> SettingsModule
DriftReportModule --> GraphModule
DriftReportModule --> ExecutionModule

note right of ExecutionModule
  HsmActionHandlers registers
  closeGhIssue + runArchiver
  against WorkItemHsmService
  on module init.

  CQRS handlers route to
  RunDispositionService and
  ExecutionService.
end note

note left of PlanningModule
  No direct ExecutionModule dep.
  Drift reports reach RunStore via
  DriftReportModule, which does
  import ExecutionModule.

  Root planner tools read graph,
  memory, GitHub, drift, and
  delegate sub-agents.
end note

note bottom of PlansModule
  WorkItemDeletedHandler
  subscribes to WorkItemDeletedEvent
  (published from RunDispositionService)
  to clean up plans/<slug>/.
end note

@enduml
