@startuml plan-lifecycle
title Plan lifecycle — prepare / approve / reopen

skinparam shadowing false

actor User
participant "PlansController" as Ctrl
participant "PlansService" as Svc
participant "PlanDrafterService" as Drafter
participant "WorkItemsService" as Items
participant "WorkItemHsmService" as Hsm
participant "GraphWriterService" as Writer
database "plans/<slug>/\n(canonical scratchpad +\nmetadata.json)" as Disk

== Prepare (planned → drafting) ==
User -> Ctrl : POST /api/plans/studio-123/prepare
Ctrl -> Svc : prepare("studio-123")
Svc -> Items : get(id)
Svc -> Svc : assertPreparable\n(planned | drafting only)
Svc -> Drafter : draft(workItem, issueBody)
note right of Drafter
  Ephemeral pi-coding-agent
  session. Returns a
  PlanDraftEnvelope with
  summary, acceptance criteria,
  implementation tasks,
  affected files, questions,
  assumptions, blockers.
end note
Drafter --> Svc : PlanDraftEnvelope

alt envelope.affected_files non-empty
  Svc -> Items : update(predicted_files = affected_files)
  Items -> Writer : apply([update_work_item])
end

alt not already drafting
  Svc -> Hsm : dispatch(user.start_draft)
  Hsm -> Writer : apply([update_work_item\nstate = pre_pr.drafting])
end

Svc -> Disk : ensurePlanDir + writeFileSync(canonical)
Svc -> Disk : writePlanMetadata(state=drafting)
Svc --> Ctrl : PlanResponse
Ctrl --> User : 200 { metadata, scratchpad_content }

== Approve (drafting → ready) ==
User -> Ctrl : POST /api/plans/studio-123/approve
Ctrl -> Svc : approve("studio-123")
Svc -> Items : get(id) — assert leaf == drafting
Svc -> Disk : readFileSync(canonical)
Svc -> Svc : extractAffectedFiles +\ndiffPredictedFiles

alt extracted non-empty
  Svc -> Items : update(predicted_files = extracted)
end

Svc -> Hsm : dispatch(draft.completed)
Hsm -> Writer : apply([update_work_item\nstate = pre_pr.ready])
Svc -> Disk : writePlanMetadata\n(state=ready, approved_at, approved_by)
Svc --> Ctrl : PlanResponse + predicted_files_diff
Ctrl --> User : 200

== Reopen (ready → drafting) ==
User -> Ctrl : POST /api/plans/studio-123/reopen
Ctrl -> Svc : reopen("studio-123")
Svc -> Hsm : dispatch(user.start_draft)
Hsm -> Writer : apply([update_work_item\nstate = pre_pr.drafting])
Svc -> Disk : writePlanMetadata\n(state=drafting, approved_*=null)
Svc --> Ctrl : PlanResponse
Ctrl --> User : 200

note over User
  Next step: POST /api/execution/launch
  (see execution-run sequence)
end note

@enduml
