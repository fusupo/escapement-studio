@startuml execution-run
title Execution run — launch to completion

skinparam shadowing false

actor User
participant "ExecutionController" as Ctrl
participant "ExecutionService" as Svc
participant "WorkItemHsmService" as Hsm
participant "WorktreeService" as Tree
participant "ScratchpadService" as Scratch
participant "RunStore" as Store
participant "RunRefinementService" as Refine
participant "RunInteractionService" as Inter
participant "pi AgentSession" as Pi
participant "WorkItemsService" as Items
participant "EventBus" as Bus
queue "SSE\n/api/execution/stream" as Sse

== Launch ==
User -> Ctrl : POST /api/execution/launch\n{ work_item_id }
Ctrl -> Svc : launch(input)
Svc -> Svc : resolveLaunchEligibility\n(plan, safety checks,\nlaunchable state)

alt eligibility.can_launch == false
  Svc -> Store : persistRun(status=blocked)
  Store --> Sse : execution_result (blocked)
  Svc --> Ctrl : { accepted: false, run }
  Ctrl --> User : 200
else ok
  Svc -> Hsm : dispatch(user.dispatch)
  Hsm -> Svc : next_state = pre_pr.in_progress
  Svc -> Store : persistRun(queued)
  Store --> Sse : execution_status
  Svc ->> Svc : executeRun(...) async
  Svc --> Ctrl : { accepted: true, run }
  Ctrl --> User : 200
end

== executeRun (async) ==
Svc -> Store : updateRun(preparing)
Store --> Sse : execution_status
Svc -> Tree : createWorktree(branch, base_ref, path)
Svc -> Tree : installDependencies(path)
Svc -> Scratch : writeScratchpad(run, node,\nrequireApproved=true)
note right of Scratch
  Launch fails closed unless plan
  metadata and canonical scratchpad
  are both ready.
end note
Svc -> Refine : refine(worktree context)
Refine -> Pi : create short refinement session
Refine -> Store : updateRun(refining_plan)
Refine -> Pi : prompt(inspect checkout, refine scratchpad, no code)
Pi --> Refine : tool events + refined scratchpad
Refine -> Scratch : syncScratchpadToCanonical
Refine -> Refine : parse structured questions + blockers
Refine -> Pi : dispose session
Refine -> Store : updateRun(disambiguating,\nphase=awaiting_confirmation, items)
Store --> Sse : execution_status

== Durable execution confirmation ==
User -> Ctrl : POST /api/execution/resolve-disambiguation\n{ run_id, responses[], additional_context?,\nconfirm_unresolved? }
Ctrl -> Svc : resolveDisambiguation
Svc -> Store : persist responses + confirmed state
Svc ->> Svc : continueRunAfterConfirmation async
Svc --> Ctrl : { resolved: true, run }
Ctrl --> User : 200

== Do-work phase ==
Svc -> Inter : runCodingSession(confirmed refinement)
Inter -> Pi : create fresh coding session
Inter -> Store : updateRun(running, phase=coding)
opt responses or additional context
  Inter -> Pi : prompt(record decisions in scratchpad)
  Inter -> Scratch : syncScratchpadToCanonical
end
Inter -> Pi : prompt(doWorkPrompt)
loop turns
  Pi --> Inter : tool_execution_start/end,\nmessage_end
  Inter -> Store : appendActivityLog\n+ emitRun(execution_status)
  Inter -> Scratch : emitChecklistIfChanged
end
Inter -> Scratch : syncScratchpadToCanonical
Inter --> Svc : { assistantText }

== Completion ==
Svc -> Tree : listChangedFiles(worktree)
Svc -> Items : update(actual_files = changedFiles)
Svc -> Store : updateRun(completed,\nchanged_files, result_summary)
Store --> Sse : execution_result
Svc -> Bus : publish RunCompletedEvent

note over Svc
  PR creation is a separate later
  step via POST /api/execution/pull-request
  (see PullRequestService).
end note

@enduml
