{
  "name": "escapement-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nodemon --signal SIGTERM --delay 500ms --ext ts,json --watch src --exec 'node --env-file-if-exists=.env --import tsx src/main.ts'",
    "dev:server": "nodemon --signal SIGTERM --delay 500ms --ext ts,json --watch src --exec 'node --env-file-if-exists=.env --import tsx src/main.ts'",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "npm run check && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "generate:work-item-state-chart": "python3 scripts/generate-work-item-state-chart.py"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.1",
    "@scion-scxml/core": "^2.6.24",
    "better-sqlite3": "^11.10.0",
    "dagre-d3-es": "^7.0.14",
    "escapement": "github:fusupo/escapement-pi",
    "fast-xml-parser": "^4.5.6",
    "marked": "^18.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "d3": "^7.9.0",
    "nodemon": "^3.1.14",
    "svelte": "^5.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.2"
  }
}
